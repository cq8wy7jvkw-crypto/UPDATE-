local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local oldGui = playerGui:FindFirstChild("EggMasterGUI")
if oldGui then oldGui:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "EggMasterGUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Name = "MainFrame"
frame.Size = UDim2.new(0, 290, 0, 390)
frame.Position = UDim2.new(0.5, -145, 0.5, -195)
frame.BackgroundColor3 = Color3.fromRGB(110, 65, 220)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 12)
frameCorner.Parent = frame

local function createLabel(text, size, position, parent)
    local label = Instance.new("TextLabel")
    label.Size = size
    label.Position = position
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.Parent = parent
    return label
end

createLabel(
    "🥚 EGG MASTER",
    UDim2.new(1, -55, 0, 38),
    UDim2.new(0, 8, 0, 2),
    frame
).TextSize = 20

local close = Instance.new("TextButton")
close.Size = UDim2.new(0, 36, 0, 32)
close.Position = UDim2.new(1, -42, 0, 5)
close.Text = "X"
close.TextColor3 = Color3.new(1, 1, 1)
close.BackgroundColor3 = Color3.fromRGB(190, 45, 60)
close.Font = Enum.Font.GothamBold
close.TextSize = 16
close.Parent = frame
Instance.new("UICorner", close).CornerRadius = UDim.new(0, 8)

close.Activated:Connect(function()
    gui.Enabled = false
end)

local function createButton(text, y, height)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -20, 0, height or 34)
    button.Position = UDim2.new(0, 10, 0, y)
    button.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 13
    button.Font = Enum.Font.GothamBold
    button.Text = text
    button.AutoButtonColor = true
    button.Parent = frame
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    return button
end

local hatchButton = createButton("AUTO HATCH: OFF", 45)
local stealButton = createButton("AUTO STEAL: OFF", 84)

createLabel(
    "SELECT EGG RARITIES",
    UDim2.new(1, -20, 0, 22),
    UDim2.new(0, 10, 0, 122),
    frame
)

local rarities = {
    "Common",
    "Rare",
    "Epic",
    "Legendary",
    "Mythic",
    "Secret"
}

local selected = {}
local rarityButtons = {}

for i, rarity in ipairs(rarities) do
    local column = (i - 1) % 2
    local row = math.floor((i - 1) / 2)
    local button = Instance.new("TextButton")

    button.Size = UDim2.new(0.5, -15, 0, 32)
    button.Position = UDim2.new(
        0, 10 + column * 140,
        0, 148 + row * 36
    )
    button.BackgroundColor3 = Color3.fromRGB(55, 55, 72)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.Text = rarity .. ": OFF"
    button.Parent = frame

    Instance.new("UICorner", button).CornerRadius =
        UDim.new(0, 6)

    selected[rarity] = false
    rarityButtons[rarity] = button

    button.Activated:Connect(function()
        selected[rarity] = not selected[rarity]
        button.Text = rarity .. (
            selected[rarity] and ": ON" or ": OFF"
        )
        button.BackgroundColor3 = selected[rarity]
            and Color3.fromRGB(40, 145, 85)
            or Color3.fromRGB(55, 55, 72)
    end)
end

local colorButton = createButton("CHANGE FRAME COLOR", 265, 32)

local status = createLabel(
    "Ready - game actions not connected",
    UDim2.new(1, -16, 0, 38),
    UDim2.new(0, 8, 0, 308),
    frame
)
status.TextSize = 11
status.TextWrapped = true

local autoHatch = false
local autoSteal = false

hatchButton.Activated:Connect(function()
    autoHatch = not autoHatch
    hatchButton.Text = "AUTO HATCH: " ..
        (autoHatch and "ON" or "OFF")
    hatchButton.BackgroundColor3 = autoHatch
        and Color3.fromRGB(40, 145, 85)
        or Color3.fromRGB(35, 35, 48)

    status.Text = autoHatch
        and "Auto Hatch enabled - awaiting game integration"
        or "Auto Hatch disabled"
end)

stealButton.Activated:Connect(function()
    autoSteal = not autoSteal
    stealButton.Text = "AUTO STEAL: " ..
        (autoSteal and "ON" or "OFF")
    stealButton.BackgroundColor3 = autoSteal
        and Color3.fromRGB(40, 145, 85)
        or Color3.fromRGB(35, 35, 48)

    status.Text = autoSteal
        and "Auto Steal enabled - awaiting game integration"
        or "Auto Steal disabled"
end)

local colors = {
    Color3.fromRGB(110, 65, 220),
    Color3.fromRGB(220, 55, 65),
    Color3.fromRGB(45, 115, 230),
    Color3.fromRGB(35, 175, 100)
}
local colorIndex = 1

colorButton.Activated:Connect(function()
    colorIndex = colorIndex % #colors + 1
    frame.BackgroundColor3 = colors[colorIndex]
end)

-- Expose selected rarities for integration with your game systems.
-- This table belongs to this LocalScript only.
local function getSelectedRarities()
    local result = {}
    for _, rarity in ipairs(rarities) do
        if selected[rarity] then
            table.insert(result, rarity)
        end
    end
    return result
end

